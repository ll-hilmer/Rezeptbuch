rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alles, was nicht ausdrücklich erlaubt ist, ist verboten
    match /{document=**} {
      allow read, write: if false;
    }

    // Synchronisierung: Jeder Nutzer darf nur seine eigenen Daten lesen und schreiben
    // (users/{uid}/items für Einträge, users/{uid}/images für Bilder)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Alte Daten aus der AI-Studio-Version: nur noch lesbar (für den Import)
    match /recipes/{recipeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /pantry/{itemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /shoppingLists/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /ingredientIcons/{iconId} {
      allow read: if request.auth != null;
    }
  }
}
